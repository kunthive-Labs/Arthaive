# ---------------------------------------------------------------------------
# Arthaive environment variables — Vercel (app hosting) + Supabase (database).
# Copy to .env.local for local development. Never put real secrets in this file.
#
# On Vercel these are set under Project -> Settings -> Environment Variables.
# Everything except the optional blocks at the bottom is required in Production.
# ---------------------------------------------------------------------------

# Supabase - get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Better Auth — PostgreSQL connection
# ---------------------------------------------------------------------------
# Better Auth owns its tables in the dedicated `better_auth` schema, created by
# supabase/migrations/022_better_auth_schema.sql. lib/auth.ts pins
# `search_path=better_auth` onto every connection and verifies it, so an
# unhonoured search_path fails loudly instead of degrading into
# `relation "user" does not exist`.
#
# WHICH SUPABASE CONNECTION MODE TO USE (Supabase Dashboard -> Connect):
#
#   Session pooler      aws-<n>-<region>.pooler.supabase.com:5432   <-- USE THIS
#       IPv4. Holds a dedicated backend for the whole session, so startup
#       parameters and SET search_path behave exactly like a direct connection.
#
#   Transaction pooler  aws-<n>-<region>.pooler.supabase.com:6543
#       IPv4, but multiplexes per statement. Session state (search_path) is not
#       guaranteed to persist between statements, which is precisely what this
#       app depends on. Do not use without validating under real concurrency.
#
#   Direct              db.<project-ref>.supabase.co:5432
#       IPv6-ONLY. Fine locally, UNUSABLE ON VERCEL — Vercel serverless
#       functions have no IPv6 egress, so every auth request fails with
#       ENETUNREACH / ENOTFOUND. lib/auth.ts refuses to start on this URL in
#       production.
#
# Note the pooler username format: `postgres.<project-ref>`, not `postgres`.
# Percent-encode reserved characters (@ : / ? # & %) in the password.
#
# Do NOT append `?sslmode=require`. node-postgres >= 8.11 treats require /
# prefer / verify-ca as verify-full, and Supabase serves a certificate chained
# to its own private "Supabase Root 2021 CA", so the handshake fails with
# SELF_SIGNED_CERT_IN_CHAIN. lib/auth.ts configures TLS itself for Supabase
# hosts (see DATABASE_SSL_CA below).
#
# Validate any candidate URL before deploying:
#   node --env-file=.env.local scripts/check-db.mjs --strict
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional. PEM contents of Supabase's root certificate, from
# Supabase Dashboard -> Project Settings -> Database -> SSL configuration
# ("Download certificate"). When set, lib/auth.ts verifies the server
# certificate against it. When unset (the default), the connection is still
# encrypted but the certificate is NOT verified, which is what Supabase's own
# `sslmode=no-verify` guidance assumes. Paste the whole PEM including the
# BEGIN/END lines; in Vercel this is a normal multi-line environment variable.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Escape hatch — should essentially NEVER be set on Vercel. It disables the
# production guard in lib/auth.ts that rejects an IPv6-only direct Supabase URL.
# The guard exists because Vercel has no IPv6 egress, so overriding it there
# just converts a clear startup error into a 100% request failure rate. Only
# meaningful on a self-hosted deployment that genuinely has IPv6 egress.
# The guard is already inactive during `next build` and in local development.
# ALLOW_DIRECT_DATABASE_URL=true

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorized redirect URIs to register:
#   http://localhost:3000/api/auth/callback/google           (local development)
#   https://arthaive.kunthive.in/api/auth/callback/google     (production)
#   https://<project>.vercel.app/api/auth/callback/google     (Vercel previews)
#
# The production callback is UNCHANGED by the move to Vercel: the domain is
# preserved and only its DNS target changes. Add the *.vercel.app entry so
# preview deployments can complete a sign-in. Google does not accept wildcard
# redirect URIs, so register the specific preview host(s) you use, or point
# previews at the production callback via BETTER_AUTH_URL.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin panel access — comma-separated list of authorized admin emails
ADMIN_EMAILS=admin@yourdomain.com

# Anthropic API — required for Phase 7 AI features (trend summaries, NL search)
ANTHROPIC_API_KEY=sk-ant-your-key

# App URL (used for OG tags, sitemap). Production is the custom domain; for a
# Vercel preview use the deployment URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://arthaive.kunthive.in

# Build / display metadata. NEXT_PUBLIC_BASE_URL is the canonical origin used
# for absolute links; NEXT_PUBLIC_APP_VERSION is surfaced in the UI / footer.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BASE_URL=https://arthaive.kunthive.in

# ---------------------------------------------------------------------------
# Optional infrastructure. Both rate limiting and Sentry GRACEFULLY NO-OP when
# their vars are unset — the code falls back to a pass-through, so the app
# still runs locally without any of the values below.
# ---------------------------------------------------------------------------

# Upstash Redis — backs API rate limiting. If unset, rate limiting is disabled
# (all requests allowed). Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry — error & performance monitoring. If the DSN is unset, Sentry is a
# no-op at runtime AND build time (no source maps uploaded). Get these from
# https://sentry.io project settings.
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
# Auth token is only needed in CI/CD to upload source maps during the build.
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ---------------------------------------------------------------------------
# Preview-only escape hatch. Normally UNSET.
# ---------------------------------------------------------------------------
# lib/supabase.ts throws rather than silently serving the empty placeholder
# dataset when Supabase credentials are missing on a deployed environment. That
# guard keys on VERCEL_ENV, which only Vercel sets:
#   - not on Vercel (GitHub Actions, local `npm run build`, `next dev`, vitest):
#     permissive already, no credentials or placeholder secrets needed;
#   - VERCEL_ENV=preview | development: set ALLOW_MISSING_SUPABASE=1 to allow a
#     deliberately database-less preview deployment;
#   - VERCEL_ENV=production: IGNORED — a production deploy always throws.
# ALLOW_MISSING_SUPABASE=1
