# Used by OpenNext/Wrangler preview. Copy to .dev.vars and add local-only
# secrets there; .dev.vars is ignored by Git.
NEXTJS_ENV=development

# Better Auth and its PostgreSQL connection
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Data API, public realtime, and server-owned private data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application services
ADMIN_EMAILS=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:8787
